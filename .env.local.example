# Copy to .env.local and fill in from your Supabase project settings.
# .env.local is gitignored — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never exposed to the browser. Required: the Join flow uses
# this to record a join request for a user who just signed up but hasn't
# confirmed their email yet (so they have no session for RLS to check).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
